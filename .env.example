# دو متغیر جدا برای یک API، و تفاوتشان عمدی است:
#   VITE_API_URL  → baseURL برای axios، پس پسوند /api را دارد
#   VITE_API_BASE → ریشه‌ی دامنه بدون /api؛ ورود، ثبت‌نام، کپچا، فرم تماس و ثبت
#                   آمار بازدید مسیر را خودشان با /api می‌سازند
# هر دو باید نشانی مطلق و با پروتکل باشند. مقدار بدون //:https نشانی نسبی حساب
# می‌شود و درخواست‌ها روی دامنه‌ی خود اپ می‌افتند.
VITE_API_URL=http://localhost:8085/api
VITE_API_BASE=http://localhost:8085
VITE_APP_NAME=TodoGoals
VITE_PUSH_PUBLIC_KEY=BFGSFXhg_hLEd77WnudywkDjC_m-JjYvRc9XC5V1y3JIhtxoT5ubQmvLBH0Lh7g9Jw6kF91SrviOZNUC-dq45KU

# نام میزبان پنل مدیریت. اگر خالی بماند، پنل روی همان مبدأ اپ کاربر و زیر مسیر
# /admin سرو می‌شود؛ در این حالت scope اپ کاربر («/») مسیر پنل را هم پوشش می‌دهد
# و مرورگر می‌تواند پیوند پنل را به اپ کاربرِ نصب‌شده بسپارد. با مقداردهی این
# متغیر، پیوند پنل به مبدأ خودش می‌رود و دو اپ کاملاً از هم جدا می‌شوند.
# کانفیگ nginx آماده: deploy/nginx/todo-admin.conf
# VITE_ADMIN_HOST=admin.sa-bt.ir
